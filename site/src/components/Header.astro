---
import Logo from './Logo.astro';
import { release } from '../lib/release';
import ThemeToggle from './ThemeToggle.astro';
---
<header style="position: sticky; top: 0; z-index: 2; background: var(--header-bg); backdrop-filter: blur(12px); border-bottom: 1px solid var(--header-line); box-shadow: 0 1px 0 var(--header-edge)">
  <div style="max-width: 1100px; margin: 0 auto; padding: 10px 24px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between">
    <a href="/#top" style="display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--fg)">
      <Logo size={30} />
      <span style="font-size: 17px; font-weight: 600; letter-spacing: -0.01em">Collate</span>
    </a>
    <nav aria-label="Main" style="display: flex; flex-wrap: wrap; align-items: center; gap: 4px">
      <a href="/#features" class="nav-text" style="text-decoration: none; color: var(--fg-2); font-size: 14px; padding: 0 10px; height: 40px; display: inline-flex; align-items: center">Features</a>
      <a href="/#speed" class="nav-text" style="text-decoration: none; color: var(--fg-2); font-size: 14px; padding: 0 10px; height: 40px; display: inline-flex; align-items: center">Speed</a>
      <a href="/#command" class="nav-text" style="text-decoration: none; color: var(--fg-2); font-size: 14px; padding: 0 10px; height: 40px; display: inline-flex; align-items: center">Command line</a>
      <a href="https://github.com/Dishant1804/Collate" class="btn nav-star" style="text-decoration: none; color: var(--fg); font-size: 14px; padding: 0 14px; height: 40px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 8px; border-radius: 10px; margin-left: 4px">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="#E3A008" aria-hidden="true"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z"></path></svg>
        Star on GitHub
      </a>
      <ThemeToggle />
      <a class="btn-primary header-dl" href={release.dmgUrl} download style="margin-left: 4px; text-decoration: none; color: #FFFFFF; font-size: 14px; font-weight: 500; padding: 0 16px; height: 40px; display: inline-flex; align-items: center; gap: 8px; border-radius: 10px">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"></path><path d="m7 10 5 5 5-5"></path><path d="M5 20h14"></path></svg>
        Download
      </a>
    </nav>
  </div>
</header>
