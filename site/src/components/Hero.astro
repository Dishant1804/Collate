---
import { release } from '../lib/release';
import DemoVideo from './DemoVideo.astro';
---
<section id="top" style="max-width: 1100px; margin: 0 auto; padding: 88px 24px 56px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px">
  <p style="margin: 0; font-size: 14px; font-weight: 500; color: var(--accent)">A fast, lightweight git diff viewer for Mac and Linux</p>
  <h1 style="margin: 0; font-size: clamp(44px, 7vw, 76px); line-height: 1.04; font-weight: 400; letter-spacing: -0.03em">See every change.<br>Commit with confidence.</h1>
  <p style="margin: 0; font-size: 19px; line-height: 1.5; color: var(--fg-2)">Review, stage and commit without leaving the diff.</p>
  <div style="display: flex; flex-direction: column; align-items: center; gap: 14px; padding-top: 10px">
    <div class="hero-ctas" style="display: flex; flex-wrap: wrap; justify-content: center; gap: 12px">
    <a class="btn-primary hero-cta" href={release.dmgUrl} download style="text-decoration: none; color: #FFFFFF; font-size: 16px; font-weight: 500; padding: 0 26px; height: 54px; display: inline-flex; align-items: center; gap: 10px; border-radius: 14px">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"></path><path d="m7 10 5 5 5-5"></path><path d="M5 20h14"></path></svg>
      Download for macOS
    </a>
    <DemoVideo />
    </div>
    <a href="https://github.com/Dishant1804/Collate" style="text-decoration: none; color: var(--fg-2); font-size: 15px; padding: 10px 4px; display: inline-flex; align-items: center; gap: 8px">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 7-5 5 5 5"></path><path d="m16 7 5 5-5 5"></path></svg>
      Read the source on GitHub
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"></path><path d="M8 7h9v9"></path></svg>
    </a>
  </div>
  <p style="margin: 0; font-size: 14px; color: var(--fg-3)"><span style="color: var(--fg); font-weight: 500">Version {release.version}</span> - Free and open source - macOS 13 or newer, universal - <a href="https://github.com/Dishant1804/Collate/releases/latest" style="color: var(--fg-2)">Linux</a></p>
</section>
