---
import ThemedShot from './ThemedShot.astro';
---
<section aria-label="Collate reviewing a change" style="max-width: 1100px; margin: 0 auto; padding: 0 24px 24px">
  <div class="shell-crisp" style="--pad: clamp(8px, 1.5vw, 16px); padding: var(--pad); border-radius: calc(12px + var(--pad))">
    <ThemedShot name="diff" priority sizes="(max-width: 1148px) calc(100vw - 64px), 1068px" alt="Collate showing a split diff of SplitPicker.tsx, with changed words marked, a review comment under line 17, and the changed files listed on the right" style="display: block; width: 100%; height: auto; border-radius: 12px; box-shadow: var(--shot-shadow)" />
  </div>
</section>
