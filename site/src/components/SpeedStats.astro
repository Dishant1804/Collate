<section aria-label="Speed at a glance" style="max-width: 1100px; margin: 0 auto; padding: 72px 24px 48px; display: flex; flex-direction: column; gap: 16px">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px">
  <div class="shell" style="border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 6px">
    <span style="font-size: 40px; font-weight: 400; letter-spacing: -0.02em">76<span style="font-size: 22px; color: var(--fg-3); margin-left: 4px">ms</span></span>
    <span style="font-size: 14px; line-height: 1.5; color: var(--fg-3)">To open a review of 416 changed files.</span>
  </div>
  <div class="shell" style="border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 6px">
    <span style="font-size: 40px; font-weight: 400; letter-spacing: -0.02em">12<span style="font-size: 22px; color: var(--fg-3); margin-left: 4px">ms</span></span>
    <span style="font-size: 14px; line-height: 1.5; color: var(--fg-3)">To refresh that review after a file changes.</span>
  </div>
  <div class="shell" style="border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 6px">
    <span style="font-size: 40px; font-weight: 400; letter-spacing: -0.02em">9.2<span style="font-size: 22px; color: var(--fg-3); margin-left: 4px">ms</span></span>
    <span style="font-size: 14px; line-height: 1.5; color: var(--fg-3)">Per scroll frame, 99 times in 100, through 95,280 lines.</span>
  </div>
</div>
<a href="#speed" style="align-self: flex-start; text-decoration: none; color: var(--fg-2); font-size: 14px; padding: 6px 0">Measured on an Apple M5 Pro with the next release. See all the numbers ↓</a>
</section>
