---
import Logo from './Logo.astro';
import { release } from '../lib/release';
---
<footer style="border-top: 1px solid var(--line)">
  <div style="max-width: 1100px; margin: 0 auto; padding: 56px 24px 48px; display: flex; flex-wrap: wrap; gap: 40px">
    <div style="flex: 2 1 300px; display: flex; flex-direction: column; gap: 16px">
      <a href="/#top" style="display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--fg)">
        <Logo size={30} />
        <span style="font-size: 17px; font-weight: 600">Collate</span>
      </a>
      <p style="margin: 0; font-size: 15px; line-height: 1.6; color: var(--fg-3); max-width: 22rem">A lightweight git diff viewer for macOS. Review, stage and commit without leaving the diff.</p>
      <div style="display: flex; gap: 8px">
        <a class="btn" href="https://github.com/Dishant1804/Collate" aria-label="Collate on GitHub" style="width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; border-radius: 10px; color: var(--fg)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 7-5 5 5 5"></path><path d="m16 7 5 5-5 5"></path></svg>
        </a>
        <a class="btn" href="https://github.com/Dishant1804/Collate/releases" aria-label="Releases" style="width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; border-radius: 10px; color: var(--fg)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12V7l-8-4-8 4v10l8 4 3-1.5"></path><path d="m4 7 8 4 8-4"></path><path d="M12 11v10"></path></svg>
        </a>
        <a class="btn" href="https://github.com/Dishant1804/Collate/issues" aria-label="Report an issue" style="width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; border-radius: 10px; color: var(--fg)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="1.5" fill="currentColor"></circle></svg>
        </a>
      </div>
      <p style="margin: 0; font-size: 13px; color: var(--fg-4)">© 2026 Collate. MIT licensed.</p>
      <a href="https://usefulshelf.co/?utm_source=collate.dishant.site&amp;utm_medium=referral&amp;utm_campaign=badge&amp;utm_content=lime" target="_blank" rel="nofollow noopener" style="align-self: flex-start"><img src="https://usefulshelf.co/badge/usefulshelf.svg?theme=lime" alt="Featured on UsefulShelf" width="248" height="66" style="display: block" /></a>
    </div>
    <nav aria-label="Product" style="flex: 1 1 140px; display: flex; flex-direction: column; gap: 4px">
      <span style="font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-4); padding-bottom: 10px">Product</span>
      <a href={release.dmgUrl} download style="text-decoration: none; color: var(--fg-2); font-size: 15px; padding: 6px 0">Download</a>
      <a href="/#features" style="text-decoration: none; color: var(--fg-2); font-size: 15px; padding: 6px 0">Features</a>
      <a href="/#speed" style="text-decoration: none; color: var(--fg-2); font-size: 15px; padding: 6px 0">Speed</a>
      <a href="/#command" style="text-decoration: none; color: var(--fg-2); font-size: 15px; padding: 6px 0">Command line</a>
      <a href="https://github.com/Dishant1804/Collate/releases" style="text-decoration: none; color: var(--fg-2); font-size: 15px; padding: 6px 0">Changelog</a>
    </nav>
    <nav aria-label="Resources" style="flex: 1 1 140px; display: flex; flex-direction: column; gap: 4px">
      <span style="font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-4); padding-bottom: 10px">Resources</span>
      <a href="https://github.com/Dishant1804/Collate" style="text-decoration: none; color: var(--fg-2); font-size: 15px; padding: 6px 0">GitHub</a>
      <a href="https://github.com/Dishant1804/Collate#keys" style="text-decoration: none; color: var(--fg-2); font-size: 15px; padding: 6px 0">Keyboard shortcuts</a>
      <a href="https://github.com/Dishant1804/Collate#agents" style="text-decoration: none; color: var(--fg-2); font-size: 15px; padding: 6px 0">Agents and MCP</a>
      <a href="https://github.com/Dishant1804/Collate/blob/main/CONTRIBUTING.md" style="text-decoration: none; color: var(--fg-2); font-size: 15px; padding: 6px 0">Contributing</a>
    </nav>
    <nav aria-label="Legal" style="flex: 1 1 140px; display: flex; flex-direction: column; gap: 4px">
      <span style="font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-4); padding-bottom: 10px">Legal</span>
      <a href="https://github.com/Dishant1804/Collate#what-collate-stores-and-sends" style="text-decoration: none; color: var(--fg-2); font-size: 15px; padding: 6px 0">Privacy</a>
      <a href="https://github.com/Dishant1804/Collate/blob/main/LICENSE" style="text-decoration: none; color: var(--fg-2); font-size: 15px; padding: 6px 0">MIT license</a>
      <a href="https://github.com/Dishant1804/Collate/issues" style="text-decoration: none; color: var(--fg-2); font-size: 15px; padding: 6px 0">Report an issue</a>
    </nav>
  </div>
</footer>
