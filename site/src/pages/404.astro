---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Page not found - Collate" description="This page doesn't exist. Collate is a fast git diff viewer for Mac." noindex>
  <Header />
  <main>
    <section style="max-width: 1100px; margin: 0 auto; padding: 120px 24px 140px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 20px">
      <p style="margin: 0; font-family: 'Geist Mono', monospace; font-size: 14px; color: var(--accent)">404</p>
      <h1 style="margin: 0; font-size: clamp(36px, 6vw, 56px); line-height: 1.05; font-weight: 400; letter-spacing: -0.03em">Nothing changed here.</h1>
      <p style="margin: 0; font-size: 17px; color: var(--fg-2)">This page doesn't exist, or it moved.</p>
      <a href="/" class="btn" style="margin-top: 8px; text-decoration: none; color: var(--fg); font-size: 15px; font-weight: 500; padding: 0 20px; height: 46px; display: inline-flex; align-items: center; border-radius: 12px">Back to Collate</a>
    </section>
  </main>
  <Footer />
</Layout>
